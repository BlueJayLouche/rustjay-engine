# Rust build output
/target

# Backup / scratch files
Cargo.toml.old
src.old/
test_pod2
profile.json.gz
profile-*.json.gz

# macOS metadata
.DS_Store
**/.DS_Store

# AI / tooling working directories
.agents/

# Spec / scratch directories created by tools
**/.spec/
**/.egui_theme_spec/

# Profiling artifacts
sputnik_*.json
sputnik_*.txt
*.trace

# Claude Code harness artifacts
.claude/

# Varda workspace directory
.kovvboj/
.varda/

# Video recordings
*.mp4
*.mov
*.avi
*.mkv
*.webm

# Local test assets / show files (large media — keep out of VCS)
testFiles/

# ledmap-studio local output (root run artifacts)
/ledmap*.json


# Proprietary Blackmagic DeckLink SDK header — user-supplied, not redistributable
examples/decklink/src/DeckLinkAPI.h

# Build/package output
dist/
/CuePool

# Agent scratch planning/lessons (see ~/.claude/CLAUDE.md workflow)
tasks/

# egui_kittest writes these next to the committed baselines on every failing
# snapshot run. The baseline `*.png` files are source; these are output.
**/tests/snapshots/*.new.png
**/tests/snapshots/*.diff.png

# Shaders dropped into kovvboj's folder stay local unless deliberately added.
# gitignore does not touch files already tracked, so the bundled set keeps
# working normally — this only stops third-party shaders from being committed
# (and so redistributed) just because they were copied in to try out.
# To bundle one on purpose: git add -f <path>
crates/kovvboj/shaders/*.fs
